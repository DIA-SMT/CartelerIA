NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# "Preguntale al mapa" siempre se interpreta localmente y no envía la consulta
# a un proveedor externo.
#
# Redacción externa del RAG normativo. Debe habilitarse explícitamente; con
# false (valor recomendado/default), la recuperación local y las citas siguen
# funcionando sin enviar la pregunta ni los fragmentos a OpenRouter. El flag no
# alcanza por sí solo: la fuente también debe estar clasificada como pública,
# revisada y autorizada tanto en el catálogo como en PostgreSQL.
ENABLE_EXTERNAL_NORMATIVA_AI=false
# Clave exclusivamente server-side. Solo se usa cuando el flag anterior es true
# y la política de privacidad no detecta datos personales o fuentes sensibles.
OPENROUTER_API_KEY=
# Opcional: modelo de OpenRouter (default anthropic/claude-3.5-haiku).
# Elegí el slug exacto en https://openrouter.ai/models
OPENROUTER_MODEL=
# RAG documental (Fase 5) — embeddings LOCALES (Transformers.js): sin API key ni
# costo. El modelo se descarga solo la primera vez (cacheado).
# Service-role key de Supabase (Settings → API). La necesitan los scripts
# administrativos, el retrieval RAG privado y las rutas server-side de
# finalización/limpieza de evidencia.
# En Vercel debe configurarse como secreto exclusivo de Production/Preview.
# NUNCA debe exponerse en el cliente ni usar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel Cron envía este secreto como Authorization: Bearer. Usar al menos
# 32 bytes aleatorios y configurarlo únicamente como secreto server-side.
CRON_SECRET=
